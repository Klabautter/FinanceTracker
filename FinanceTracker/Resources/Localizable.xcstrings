    "CSV, Excel oder PDF-Kontoauszug von Bank, Karte oder Broker" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSV, Excel oder PDF-Kontoauszug von Bank, Karte oder Broker"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSV, Excel, or PDF statement from your bank, card, or broker"
          }
        }
      }
    },
    "CSV- und Excel-Dateien sowie PDF-Kontoauszüge mit einer Datums- und einer Betragsspalte, egal von welcher Bank oder Karte. Spalten und Buchungsarten (Kartenzahlung, Aufladung, Erstattung, Cashback, Gebühr, Zinsen) werden auf Deutsch und Englisch erkannt; unbekannte Arten ordnest du einmal zu. Kategorien kommen aus deinen Regeln." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSV- und Excel-Dateien sowie PDF-Kontoauszüge mit einer Datums- und einer Betragsspalte, egal von welcher Bank oder Karte. Spalten und Buchungsarten (Kartenzahlung, Aufladung, Erstattung, Cashback, Gebühr, Zinsen) werden auf Deutsch und Englisch erkannt; unbekannte Arten ordnest du einmal zu. Kategorien kommen aus deinen Regeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSV and Excel files as well as PDF statements with a date and an amount column, from any bank or card. Columns and transaction types (card payments, top-ups, refunds, cashback, fees, interest) are recognised in English and German; you assign unknown types once. Categories come from your rules."
          }
        }
      }
    },
    "CSV-, Excel- oder PDF-Auszüge deiner Bank lokal einlesen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSV-, Excel- oder PDF-Auszüge deiner Bank lokal einlesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read CSV, Excel, or PDF statements from your bank locally."
          }
        }
      }
    },
    "CSV-, Excel- und PDF-Importe werden lokal verarbeitet. FinanceTracker führt keine Zahlungen aus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSV-, Excel- und PDF-Importe werden lokal verarbeitet. FinanceTracker führt keine Zahlungen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSV, Excel, and PDF imports are processed locally. FinanceTracker doesn't make payments."
          }
        }
      }
    },

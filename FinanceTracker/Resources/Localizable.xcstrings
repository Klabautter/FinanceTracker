    "Buchungen, die schon im Konto sind, werden nicht doppelt importiert, auch wenn sie aus einer anderen Datei oder dem Bankabruf stammen. Gleiche Zeilen in einem anderen Konto gelten nicht als doppelt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buchungen, die schon im Konto sind, werden nicht doppelt importiert, auch wenn sie aus einer anderen Datei oder dem Bankabruf stammen. Gleiche Zeilen in einem anderen Konto gelten nicht als doppelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transactions already in the account are not imported twice, even if they come from another file or from bank sync. Identical rows in a different account are not treated as duplicates."
          }
        }
      }
    },

          "stringUnit" : {
            "state" : "translated",
            "value" : "The key for your %@ application will be removed from this Mac. %@ until you load it again. Accounts and transactions are kept.\n\nOnly want to remove one bank? Then choose “Disconnect” for that bank."
          }

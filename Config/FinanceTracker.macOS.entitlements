<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Bank-Sync und FX-Kurse benötigen ausgehende HTTPS-Verbindungen. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- CSV- und Backup-Export schreiben ausschließlich in gewählte Ziele. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Ohne Apple-Developer-Team-ID (selbst signiert) hat die App keine
	     Team-ID; die Library-Validation des Hardened Runtime ließe dann
	     das eingebettete Sparkle.framework nicht laden. Entfällt mit einer
	     Developer-ID-Signatur. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Sparkle: Verbindung zum Installer-Dienst, der das Update außerhalb
	     der Sandbox einspielt (sparkle-project.org/documentation/sandboxing). -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>

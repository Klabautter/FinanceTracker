<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widget-Erweiterungen laufen immer in der Sandbox. Die App-Group mit
	     Team-ID-Präfix teilt den Stand mit der App; sie greift erst mit
	     einer Signatur, die eine Team-ID trägt (Developer ID). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)de.klabautter.FinanceTracker</string>
	</array>
</dict>
</plist>

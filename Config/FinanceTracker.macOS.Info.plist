<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App-Sprachen: Deutsch und Englisch (Rückfall Englisch, siehe
         developmentLanguage in project.yml). -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>de</string>
        <string>en</string>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>de.klabautter.ftbackup</string>
            <key>UTTypeDescription</key>
            <string>FinanceTracker-Backup</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.zip-archive</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ftbackup</string>
                </array>
            </dict>
        </dict>
    </array>
    <!-- Sparkle (nur macOS): Update-Liste im GitHub-Repo, Updates als ZIP
         in den GitHub-Releases. Scripts/release.sh schreibt beides. Das Repo
         muss zu REPO in Scripts/release.sh passen. -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/Klabautter/FinanceTracker/main/appcast.xml</string>
    <!-- Öffentlicher Teil des Signaturschlüssels; der private liegt nur im
         Schlüsselbund des Release-Macs (Konto "financetracker"). -->
    <key>SUPublicEDKey</key>
    <string>Xk1Vfjd7dQqs3IRy+hJa/tlgF1TMCGVVw9BI/SlBSs0=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <!-- App Sandbox: Sparkle installiert über seinen Installer-Dienst. -->
    <key>SUEnableInstallerLauncherService</key>
    <true/>
</dict>
</plist>
